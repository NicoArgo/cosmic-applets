# The entry the panel lists as an applet. The button is our own applet
# (cosmic-applet-folder-button): it brings forward a file-manager window
# already showing the folder, and only opens one when there is none.
[Desktop Entry]
Name=Pictures Folder Button
Name[pt_BR]=Botão da pasta Imagens
Name[pt]=Botão da pasta Imagens
Comment=Open your Pictures folder in the file manager
Comment[pt_BR]=Abre sua pasta Imagens no gerenciador de arquivos
Comment[pt]=Abre sua pasta Imagens no gerenciador de arquivos
Type=Application
Exec=cosmic-applet-folder-button pictures
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;Folder;Pictures;Images;
Icon=folder-pictures-symbolic
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-OverflowPriority=1
