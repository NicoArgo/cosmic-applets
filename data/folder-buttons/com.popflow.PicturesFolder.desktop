# Nobody launches this entry: cosmic-panel-button reads Name, Icon and Exec
# from here to draw the button, and runs Exec through `sh -c`. That is what
# makes the command substitution below work, and the point of it is that the
# folder is resolved at press time -- so the button follows the XDG Pictures
# directory wherever it is, under whatever name the user's language gives it,
# instead of freezing one machine's path into a file we ship. NoDisplay keeps
# it out of the launcher, where a second "Pictures" would only be confusing.
#
# Both Name[pt] and Name[pt_BR], deliberately: the locale lookup tries the
# whole LANG ("pt_BR.UTF-8") and then only what precedes the underscore
# ("pt"), never the bare "pt_BR" -- so the regional key alone never matches.
# That is why every translated entry COSMIC ships carries both.
[Desktop Entry]
Name=Pictures
Name[pt_BR]=Imagens
Name[pt]=Imagens
Comment=Open the Pictures folder
Comment[pt_BR]=Abre a pasta Imagens
Comment[pt]=Abre a pasta Imagens
Type=Application
Exec=cosmic-files "$(xdg-user-dir PICTURES)"
Terminal=false
Categories=COSMIC;
Icon=folder-pictures-symbolic
StartupNotify=true
NoDisplay=true
